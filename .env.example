# LLM 配置 (OpenAI 兼容接口)
LARGE_LLM_API_KEY=your_large_model_api_key_here
LARGE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LARGE_LLM_MODEL=qwen3.5-plus

SMALL_LLM_API_KEY=your_small_model_api_key_here
SMALL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMALL_LLM_MODEL=qwen3.5-flash

EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

IMAGE_GEN_API_KEY=your_image_gen_api_key_here
IMAGE_GEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
IMAGE_GEN_MODEL=qwen-image-2.0
ENABLE_BACKGROUND_GENERATION=true

# 人格配置
CHARACTER_NAME=依鸣 # 人格名称
LIVE2D_MODEL_PATH=/models/yachiyo/八千代辉夜姬.model3.json

# 系统运行参数
PYTHONUTF8=1 # 强制 Python 使用 UTF-8 作为默认编码（Windows 兼容性）
HEARTBEAT_INTERVAL=10 # 心跳间隔，单位为秒
START_TIME=# 系统启动时间，ISO 8601格式，留空会自动设置为系统启动时的当前时间，建议留空 填写？会从上一次系统关闭时的时间继续计算，如果时间加速因子不为1.0建议填写？

# 状态管理
TIME_ACCEL_FACTOR=1.0 # 时间加速因子，1.0表示正常时间流逝，2.0表示时间流逝加快一倍
STATE_IDLE_MIN_TIMEOUT=30 # 空闲状态最小超时时间，单位为秒
STATE_IDLE_MAX_TIMEOUT=1800 # 空闲状态最大超时时间，单位为秒
CONTEXT_WINDOW_SIZE=20 # 上下文窗口大小，单位为消息条数
STATE_UPDATE_INTERVAL=1 #几轮对话进行一次状态更新，单位为轮，建议设置为1
# 显式缓存：固定 system prompt 会自动启用 DashScope 显式缓存（5分钟 TTL）
# cached token 费率约为正常 token 的 10%，无需额外配置

# pg数据库管理
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password
PG_DB=ember_db

# 记忆相关参数
MEMORY_ENCODE_THRESHOLD=5000 # 记忆编码阈值，当 chat_history.log 字符数达到此值时触发记忆预处理
MEMORY_KEEP_LAST_LINES=5 # 记忆编码时保留的最后行数
MEMORY_DECENT_FACTOR=0.2 # 记忆衰减因子，范围为0到1，值越大记忆衰减越快
RECALL_TOP_K=5 # 回忆时检索的最相关记忆条数
LLM_TEMPERATURE=0.7 # LLM 生成温度

# PostgreSQL 实体关系图谱
ENABLE_GRAPH_MEMORY=True
