# LLM 配置 (OpenAI 兼容接口)
LARGE_LLM_API_KEY=your_large_model_api_key_here
LARGE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LARGE_LLM_MODEL=qwen3.5-plus

SMALL_LLM_API_KEY=your_small_model_api_key_here
SMALL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMALL_LLM_MODEL=qwen3.5-flash

EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# 人格配置
CHARACTER_NAME=依鸣 # 人格名称

# 系统运行参数
HEARTBEAT_INTERVAL=10 # 心跳间隔，单位为秒
PROACTIVE_MIN_INTERVAL=600 # 普通续聊的现实秒间隔；事件与明确提醒另有预算，未回应不连续闲聊
DIALOGUE_POLICY=expressive_v1 # 自然表达与当前视角；legacy 可停用新表达层，读取原始 YAML
PROACTIVE_POLICY=events_v1 # 事件投递预算；legacy 恢复统一节流
PROACTIVE_EVENT_GAP=120 # 普通角色/共同活动事件的最小现实秒间隔
PROACTIVE_HOURLY_LIMIT=3 # 普通主动消息每现实小时上限；明确网页提醒另限6次
ROLE_CONTINUITY_ENABLED=true # 情绪事件与角色自有活动；关闭不删除旧记录
ROLE_EMOTION_HALF_LIFE=3600 # 情绪余韵半衰期，世界秒
ROLE_ACTIVITY_SECONDS=900 # 一轮角色笔记整理的时长，世界秒
# 留空使用现实时间；? 延续上次状态；也可填写 ISO 8601 时间。
START_TIME=
TIMEZONE=Asia/Shanghai

# 状态管理
TIME_ACCEL_FACTOR=1.0 # 时间加速因子，1.0表示正常时间流逝，2.0表示时间流逝加快一倍
STATE_IDLE_MIN_TIMEOUT=30 # 空闲状态最小超时时间，单位为秒
STATE_IDLE_MAX_TIMEOUT=1800 # 空闲状态最大超时时间，单位为秒
CONTEXT_WINDOW_SIZE=20 # 上下文窗口大小，单位为消息条数
STATE_UPDATE_INTERVAL=1 #几轮对话进行一次状态更新，单位为轮，建议设置为1
# 显式缓存：固定 system prompt 会自动启用 DashScope 显式缓存（5分钟 TTL）
# cached token 费率约为正常 token 的 10%，无需额外配置

# pg数据库管理
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=your_password
PG_DB=ember_db

# 记忆相关参数
MEMORY_DECENT_FACTOR=0.2 # 记忆衰减因子，范围为0到1，值越大记忆衰减越快
RECALL_TOP_K=5 # 回忆时检索的最相关记忆条数
MEMORY_ENCODE_MESSAGES=12 # 日志中累计消息数触发整理，不依赖空闲模型决定
MEMORY_ENCODE_INTERVAL=120 # 有新对话时的周期整理间隔（现实秒）
MEMORY_RETRY_INTERVAL=60 # 自动整理/失败重试的最小间隔（现实秒）

# Neo4j 知识图谱配置
ENABLE_NEO4J=True # 是否启用 Neo4j 知识图谱功能
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DB=neo4j
